/* MailStudio Google Web — no external SMTP server, no paid resources. */
const ADMIN_EMAIL = PropertiesService.getScriptProperties().getProperty('adminEmail') || '';
const TABLES = ['config','contacts','tasks','outgoing','messages','drafts'];
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('MailStudio · 免费邮件工作台').addMetaTag('viewport','width=device-width, initial-scale=1');}
function actor_(){const e=Session.getEffectiveUser().getEmail().toLowerCase();if(!e)throw Error('请使用 Google 账号授权访问。');return e;}
function props_(){return PropertiesService.getScriptProperties();}
function registry_(){return JSON.parse(props_().getProperty('registry')||'{}');}
function assertAccess_(email){const me=actor_(),r=registry_();if(me!==ADMIN_EMAIL&&!r[me])throw Error('此账号尚未受邀加入工作台。');if(email&&me!==ADMIN_EMAIL&&email!==me)throw Error('只能操作自己授权的邮箱。');return me;}
function sheet_(email){assertAccess_(email);const r=registry_()[email];if(!r||!r.sheet)throw Error('该邮箱尚未完成授权连接。');return SpreadsheetApp.openById(r.sheet);}
function rows_(ss,name){const s=ss.getSheetByName(name),n=s.getLastRow();return n<2?[]:s.getRange(2,1,n-1,2).getValues().filter(r=>r[0]).map(r=>JSON.parse(r[1]));}
function put_(ss,name,obj){const s=ss.getSheetByName(name),n=s.getLastRow(),ids=n<2?[]:s.getRange(2,1,n-1,1).getValues();const i=ids.findIndex(r=>String(r[0])===String(obj.id));const value=JSON.stringify(obj);if(value.length>45000)throw Error('单条记录超过保存大小限制。');s.getRange(i<0?n+1:i+2,1,1,2).setValues([[String(obj.id),value]]);return obj;}
function get_(ss,name,id){return rows_(ss,name).find(r=>String(r.id)===String(id));}
function del_(ss,name,id){const s=ss.getSheetByName(name),n=s.getLastRow();if(n<2)return;const i=s.getRange(2,1,n-1,1).getValues().findIndex(r=>String(r[0])===String(id));if(i>=0)s.deleteRow(i+2);}
function cfg_(ss){return get_(ss,'config','main');}
function uid_(){return Utilities.getUuid();}
function time_(){return Date.now();}
function email_(s){s=String(s||'').trim().toLowerCase();if(!/^[a-z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-z0-9.-]+\.[a-z]{2,}$/i.test(s)||/[\s\r\n]/.test(s))throw Error('邮箱地址格式不正确。');return s;}
function text_(s,max){s=String(s||'');if(s.length>max)throw Error('输入内容过长。');return s;}
function lock_(fn){const l=LockService.getScriptLock();if(!l.tryLock(10000))throw Error('正在处理另一个请求，请稍后重试。');try{return fn();}finally{l.releaseLock();}}
function defaults_(email){return {id:'main',email,name:'',group:'未分组',enabled:false,schedule_ready:false,total_cap:30,first_cap:20,follow_cap:10,manual_cap:10,window_start:'09:00',window_end:'17:00',zone:'America/New_York',weekdays:'0,1,2,3,4,5,6',interval_mode:'random',min_minutes:25,max_minutes:45,jitter:false,warm_days:5,warm_cap:10,start_date:'',first_active:null,next_auto:0,hold:'',template:{subject:'',body:'',follow1:'',follow2:'',follow1_days:3,follow2_days:7}};}
function enroll_(){const me=actor_();return lock_(()=>{let r=registry_();if(me!==ADMIN_EMAIL&&!r[me])throw Error('请先由管理员邀请此 Gmail 地址。');if(r[me]&&r[me].sheet)return r[me];Gmail.Users.getProfile('me');const ss=SpreadsheetApp.create('MailStudio · '+me);ss.getSheets()[0].setName('config');TABLES.slice(1).forEach(n=>ss.insertSheet(n));TABLES.forEach(n=>{const s=ss.getSheetByName(n);s.appendRow(['id','json']);s.setFrozenRows(1);s.getRange('A:B').setNumberFormat('@');});put_(ss,'config',defaults_(me));if(me!==ADMIN_EMAIL)DriveApp.getFileById(ss.getId()).addEditor(ADMIN_EMAIL);r[me]={email:me,sheet:ss.getId(),joined:time_()};props_().setProperty('registry',JSON.stringify(r));return r[me];});}
function quota_(){try{return MailApp.getRemainingDailyQuota();}catch(e){return null;}}
function snapshot_(){const me=assertAccess_(),reg=registry_(),emails=me===ADMIN_EMAIL?Object.keys(reg):[me];const accounts=emails.map(email=>{if(!reg[email].sheet)return {email,invited:true};try{const ss=sheet_(email),c=cfg_(ss),o=rows_(ss,'outgoing');return {email,config:c,usage:usage_(c,o,time_()),sheet:reg[email].sheet};}catch(e){return {email,error:String(e.message)};}});return {me,admin:me===ADMIN_EMAIL,accounts,quota:quota_(),url:ScriptApp.getService().getUrl(),trigger:ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='mailstudioTick')};}
function api(action,p){p=p||{};if(action==='enroll')return enroll_();assertAccess_();if(action==='snapshot')return snapshot_();if(action==='invite')return lock_(()=>{if(actor_()!==ADMIN_EMAIL)throw Error('仅管理员可邀请邮箱。');const email=email_(p.email),r=registry_();if(Object.keys(r).length>=100&&!r[email])throw Error('工作台最多登记 100 个邮箱。');r[email]=r[email]||{email,invited:true};props_().setProperty('registry',JSON.stringify(r));return {ok:true};});if(action==='installTrigger'){const me=actor_();sheet_(me);const ts=ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='mailstudioTick');if(!ts.length)ScriptApp.newTrigger('mailstudioTick').timeBased().everyMinutes(1).create();return {ok:true};}if(action==='stopTrigger'){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='mailstudioTick').forEach(t=>ScriptApp.deleteTrigger(t));return {ok:true};}
  const email=p.email||actor_(),ss=sheet_(email);
  if(action==='data')return {config:cfg_(ss),contacts:rows_(ss,'contacts'),tasks:rows_(ss,'tasks'),outgoing:rows_(ss,'outgoing').slice(-500).reverse(),messages:rows_(ss,'messages').slice(-1000),drafts:rows_(ss,'drafts')};
  if(action==='sync'){if(email!==actor_())throw Error('请切换到此 Google 邮箱再同步；其他邮箱可查看已缓存会话。');return lock_(()=>sync_(ss));}
  if(action==='backup')return {format:'mailstudio-google-1',email,data:Object.fromEntries(TABLES.map(n=>[n,rows_(ss,n)]))};
  return lock_(()=>{
    if(action==='schedule'){const c=cfg_(ss),v=p.config;validateSchedule_(v);Object.keys(v).forEach(k=>{if(['total_cap','first_cap','follow_cap','manual_cap','window_start','window_end','zone','weekdays','interval_mode','min_minutes','max_minutes','jitter','warm_days','warm_cap','start_date','enabled','name','group'].includes(k))c[k]=v[k];});c.schedule_ready=true;return put_(ss,'config',c);}
    if(action==='template'){const c=cfg_(ss),t=p.template;['subject','body','follow1','follow2'].forEach(k=>t[k]=text_(t[k],k==='subject'?500:20000));['follow1_days','follow2_days'].forEach(k=>{t[k]=Number(t[k]);if(!Number.isFinite(t[k])||t[k]<1||t[k]>365)throw Error('回访间隔为 1–365 天。');});c.template=t;put_(ss,'config',c);return {ok:true};}
    if(action==='import'){const lines=Utilities.parseCsv(text_(p.csv,1000000).replace(/^\uFEFF/,''));if(lines.length>2001)throw Error('每次最多导入 2000 位联系人。');const heads=lines.shift().map(x=>x.trim().toLowerCase()),ix=heads.indexOf('email');if(ix<0)throw Error('CSV 需要 email 表头。');const seen=new Set(rows_(ss,'contacts').map(c=>c.email)),batch=text_(p.batch,100),t=cfg_(ss).template;let added=0,duplicates=0,errors=[];lines.forEach((r,i)=>{if(!r.some(Boolean))return;try{const e=email_(r[ix]);if(seen.has(e)){duplicates++;return;}const obj={};heads.forEach((h,j)=>obj[h]=r[j]||'');const c={id:uid_(),email:e,first_name:text_(obj.first_name,100),location:text_(obj.location,150),batch,status:'queued',control:'active',subject:text_(obj.subject||render_(t.subject,obj),500),body:text_(obj.body||render_(t.body,obj),20000),created:time_()};put_(ss,'contacts',c);seen.add(e);added++;}catch(e){errors.push('第 '+(i+2)+' 行：'+e.message);}});return {added,duplicates,errors};}
    if(action==='contact'){const c=get_(ss,'contacts',p.id);if(!c)throw Error('联系人不存在。');if(!['active','paused','blocked'].includes(p.control))throw Error('状态无效。');c.control=p.control;if(c.status==='queued'){c.subject=text_(p.subject,500);c.body=text_(p.body,20000);}return put_(ss,'contacts',c);}
    if(action==='applyTemplate'){const t=cfg_(ss).template;let n=0;rows_(ss,'contacts').filter(c=>c.batch===p.batch&&c.status==='queued').forEach(c=>{c.subject=render_(t.subject,c);c.body=render_(t.body,c);put_(ss,'contacts',c);n++;});return {updated:n};}
    if(action==='task'){const batch=text_(p.batch,100),cs=rows_(ss,'contacts');if(!cs.some(c=>c.batch===batch))throw Error('请先导入该批次的联系人。');if(rows_(ss,'tasks').some(t=>t.batch===batch&&['paused','running'].includes(t.state)))throw Error('此批次已有未结束任务。');return put_(ss,'tasks',{id:uid_(),name:text_(p.name,100)||batch,batch,state:'paused',created:time_()});}
    if(action==='taskState'){const t=get_(ss,'tasks',p.id);if(!t||t.state==='cancelled')throw Error('任务不存在或已取消。');if(!['paused','running','cancelled'].includes(p.state))throw Error('任务状态无效。');const c=cfg_(ss);if(p.state==='running'&&(!c.schedule_ready||!c.enabled))throw Error('请先设置日程并允许此邮箱发送。');t.state=p.state;return put_(ss,'tasks',t);}
    if(action==='draft'){const c=get_(ss,'contacts',p.id);if(!c)throw Error('联系人不存在。');return put_(ss,'drafts',{id:p.id,body:text_(p.body,20000),updated:time_()});}
    if(action==='reply'){if(email!==actor_())throw Error('请切换到原发件 Google 邮箱后回复。');const c=get_(ss,'contacts',p.id);if(!c||!c.threadId)throw Error('此联系人还没有可回复的已发送会话。');const key=text_(p.key,100);if(!key)throw Error('缺少操作编号。');const existing=get_(ss,'outgoing',key);if(existing)return existing;const body=text_(p.body,20000);if(!body.trim())throw Error('正文不能为空。');check_(cfg_(ss),rows_(ss,'outgoing'),'manual',time_());const res=send_(ss,c,'manual',body,key,p.attachments||[]);if(res.state==='sent')del_(ss,'drafts',c.id);return res;}
    if(action==='reconcile'){if(email!==actor_())throw Error('请切换到该 Google 邮箱后核对。');return reconcile_(ss);}
    if(action==='resume'){const c=cfg_(ss);if(rows_(ss,'outgoing').some(o=>o.state==='pending'))throw Error('仍有结果待确认，请先核对 Gmail。');c.hold='';put_(ss,'config',c);return {ok:true};}
    if(action==='restore'){const b=p.backup;if(!b||b.format!=='mailstudio-google-1'||!b.data)throw Error('只支持本免费网页版的 JSON 备份；桌面 SQLite 需转换后导入。');if(rows_(ss,'contacts').length||rows_(ss,'outgoing').length)throw Error('仅允许向空邮箱工作区恢复。');const d=b.data;TABLES.forEach(n=>{if(!Array.isArray(d[n]))throw Error('备份缺少 '+n);if(d[n].length>20000)throw Error('备份数据量过大。');d[n].forEach(o=>{if(!o.id||JSON.stringify(o).length>45000)throw Error('备份记录无效。');});});const c=d.config.find(x=>x.id==='main');if(!c)throw Error('缺少邮箱配置。');c.email=email;c.enabled=false;c.hold='';d.tasks.forEach(t=>{if(t.state==='running')t.state='paused';});d.contacts.forEach(c=>{if(c.status==='queued')c.control='paused';});TABLES.forEach(n=>d[n].forEach(o=>put_(ss,n,o)));return {ok:true};}
    throw Error('不支持此操作。');
  });
}
function render_(s,c){return String(s||'').replace(/\{\{(first_name|location)\}\}/g,(_,k)=>c[k]||'');}
function validateSchedule_(c){['total_cap','first_cap','follow_cap','manual_cap','min_minutes','max_minutes','warm_cap'].forEach(k=>{c[k]=Number(c[k]);if(!Number.isInteger(c[k])||c[k]<1||c[k]>10000)throw Error('额度与间隔须为正整数。');});c.warm_days=Number(c.warm_days);if(!Number.isInteger(c.warm_days)||c.warm_days<0||c.warm_days>365)throw Error('初期天数无效。');if(c.min_minutes>c.max_minutes)throw Error('最长间隔不能小于最短间隔。');if(!['fixed','random'].includes(c.interval_mode))throw Error('间隔方式无效。');if(!/^\d{2}:\d{2}$/.test(c.window_start)||!/^\d{2}:\d{2}$/.test(c.window_end)||c.window_start>=c.window_end||c.window_end>'23:59')throw Error('请设置有效的同日发送时段。');if(!/^([0-6],)*[0-6]$/.test(c.weekdays))throw Error('至少选择一个有效活动日。');if(c.start_date&&!/^\d{4}-\d{2}-\d{2}$/.test(c.start_date))throw Error('开始日期无效。');try{Utilities.formatDate(new Date(),c.zone,'yyyy-MM-dd');}catch(e){throw Error('时区无效。');}c.enabled=!!c.enabled;c.jitter=!!c.jitter;}
function local_(c,now){const s=Utilities.formatDate(new Date(now),c.zone,'yyyy-MM-dd HH:mm u').split(' ');return {date:s[0],hm:s[1],day:String(Number(s[2])-1)};}
function inWindow_(c,now){const l=local_(c,now);return c.weekdays.split(',').includes(l.day)&&(!c.start_date||l.date>=c.start_date)&&l.hm>=c.window_start&&l.hm<c.window_end;}
function usage_(c,os,now){const day=local_(c,now).date,u={first:0,follow:0,manual:0,total:0,pending:0};os.forEach(o=>{if(o.state==='pending'||(o.state==='sent'&&local_(c,o.sent_at||o.created).date===day)){const k=o.kind.startsWith('follow')?'follow':o.kind;u[k]=(u[k]||0)+1;u.total++;if(o.state==='pending')u.pending++;}});return u;}
function cap_(c,now){const age=c.first_active?Math.round((Date.parse(local_(c,now).date)-Date.parse(local_(c,c.first_active).date))/86400000):0;return c.warm_days&&age<c.warm_days?Math.min(c.total_cap,c.warm_cap):c.total_cap;}
function check_(c,os,kind,now){if(!c.enabled)throw Error('邮箱发送已关闭。');if(c.hold)throw Error(c.hold);if(os.some(o=>o.state==='pending'))throw Error('存在发送结果待确认，请先核对。');const u=usage_(c,os,now),k=kind.startsWith('follow')?'follow':kind;if(u.total>=cap_(c,now)||u[k]>=c[k+'_cap'])throw Error('今日本地额度已用完。');if(kind!=='manual'){if(!c.schedule_ready||!inWindow_(c,now)||c.next_auto>now)throw Error('尚未到此邮箱的发送时间。');}return true;}
function next_(c,now){const mins=c.interval_mode==='fixed'?c.min_minutes:c.min_minutes+Math.random()*(c.max_minutes-c.min_minutes);return now+mins*60000+(c.jitter?(30+Math.random()*30)*1000:0);}
function header_(msg,name){return (msg.payload.headers||[]).find(h=>h.name.toLowerCase()===name.toLowerCase())?.value||'';}
function cleanHeader_(s){return String(s||'').replace(/[\r\n]/g,' ');}
function b64_(s){return Utilities.base64Encode(Utilities.newBlob(s).getBytes()).replace(/.{1,76}/g,'$&\r\n').trim();}
function mime_(from,to,subject,body,mid,parent,attachments){const boundary='ms_'+mid.replace(/[^a-z0-9]/gi,'');let h=['From: '+cleanHeader_(from),'To: '+email_(to),'Subject: =?UTF-8?B?'+Utilities.base64Encode(subject,Utilities.Charset.UTF_8)+'?=','Message-ID: '+mid,'MIME-Version: 1.0'];if(parent){h.push('In-Reply-To: '+cleanHeader_(parent.mid),'References: '+cleanHeader_((parent.references||'')+' '+parent.mid));}const part='Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n'+b64_(body);if(!attachments.length)return h.concat(part).join('\r\n');h.push('Content-Type: multipart/mixed; boundary="'+boundary+'"');let out=h.join('\r\n')+'\r\n\r\n--'+boundary+'\r\n'+part;attachments.forEach(a=>{if(!/^[a-zA-Z0-9+/=]+$/.test(a.base64))throw Error('附件内容无效。');out+='\r\n--'+boundary+'\r\nContent-Type: application/octet-stream\r\nContent-Disposition: attachment; filename*=UTF-8\'\''+encodeURIComponent(a.name)+'\r\nContent-Transfer-Encoding: base64\r\n\r\n'+a.base64.replace(/.{1,76}/g,'$&\r\n');});return out+'\r\n--'+boundary+'--\r\n';}
function parent_(c){if(!c.threadId)return null;const th=Gmail.Users.Threads.get('me',c.threadId,{format:'metadata',metadataHeaders:['Message-ID','References','Subject']});const m=th.messages[th.messages.length-1];return {mid:header_(m,'Message-ID'),references:header_(m,'References'),subject:header_(m,'Subject'),threadId:c.threadId};}
function send_(ss,c,kind,body,key,attachments){const cfg=cfg_(ss);if(cfg.email!==actor_())throw Error('发件邮箱与授权账号不一致。');const old=get_(ss,'outgoing',key);if(old)return old;attachments=attachments||[];if(attachments.length>5||attachments.reduce((n,a)=>n+(a.base64||'').length,0)>7000000)throw Error('附件最多 5 个，总大小约 5 MB。');const parent=kind==='first'?null:parent_(c);if(kind!=='first'&&(!parent||!parent.mid))throw Error('缺少原会话信息，发送已停止。');const subject=parent?parent.subject:c.subject;if(!subject.trim()||!body.trim())throw Error('主题和正文不能为空。');const mid='<'+key+'@mailstudio.local>',raw=Utilities.base64EncodeWebSafe(Utilities.newBlob(mime_(cfg.name?'=?UTF-8?B?'+Utilities.base64Encode(cfg.name,Utilities.Charset.UTF_8)+'?= <'+cfg.email+'>':cfg.email,c.email,subject,body,mid,parent,attachments)).getBytes()).replace(/=+$/,'');const o={id:key,contact_id:c.id,to:c.email,kind,state:'pending',created:time_(),message_id:mid,subject,body:body.slice(0,15000),frozen:kind==='first'?Object.assign({},cfg.template):null};put_(ss,'outgoing',o);SpreadsheetApp.flush();try{const req={raw};if(parent)req.threadId=parent.threadId;const res=Gmail.Users.Messages.send(req,'me');o.gmail_id=res.id;o.threadId=res.threadId;o.state='sent';o.sent_at=time_();put_(ss,'outgoing',o);applySent_(ss,c,o);return o;}catch(e){o.state='pending';o.detail=String(e.message).slice(0,1000);put_(ss,'outgoing',o);cfg.hold='发送结果尚未确认，请核对 Gmail 后继续。';put_(ss,'config',cfg);return o;}}
function applySent_(ss,c,o){const cfg=cfg_(ss);c.threadId=o.threadId;c.last_sent=o.sent_at;if(o.kind==='first'){c.status='sent';c.first_sent=o.sent_at;c.frozen=Object.assign({},o.frozen||cfg.template);c.follow_stage=0;}if(o.kind==='follow1')c.follow_stage=1;if(o.kind==='follow2')c.follow_stage=2;put_(ss,'contacts',c);cfg.first_active=cfg.first_active||o.sent_at;if(o.kind!=='manual')cfg.next_auto=next_(cfg,o.sent_at);put_(ss,'config',cfg);}
function reconcile_(ss){let resolved=0;rows_(ss,'outgoing').filter(o=>o.state==='pending').forEach(o=>{const found=Gmail.Users.Messages.list('me',{q:'in:sent rfc822msgid:'+o.message_id,maxResults:5}).messages||[];if(found.length){const m=Gmail.Users.Messages.get('me',found[0].id,{format:'metadata'});o.state='sent';o.gmail_id=m.id;o.threadId=m.threadId;o.sent_at=Number(m.internalDate);put_(ss,'outgoing',o);const c=get_(ss,'contacts',o.contact_id);if(c)applySent_(ss,c,o);resolved++;}});const remaining=rows_(ss,'outgoing').filter(o=>o.state==='pending').length;if(!remaining){const cfg=cfg_(ss);if(cfg.hold==='发送结果尚未确认，请核对 Gmail 后继续。'){cfg.hold='';put_(ss,'config',cfg);}}return {resolved,remaining};}
function decode_(part){try{return part.body&&part.body.data?Utilities.newBlob(Utilities.base64DecodeWebSafe(part.body.data)).getDataAsString('UTF-8'):'';}catch(e){return '';}}
function plain_(part){if(part.mimeType==='text/plain')return decode_(part);for(const p of part.parts||[]){const t=plain_(p);if(t)return t;}return '';}
function sync_(ss){const cs=rows_(ss,'contacts').filter(c=>c.threadId),start=time_();let count=0;const cursor=Number(PropertiesService.getUserProperties().getProperty('syncCursor')||0);for(let n=0;n<Math.min(cs.length,20);n++){const i=(cursor+n)%cs.length,c=cs[i],th=Gmail.Users.Threads.get('me',c.threadId,{format:'full'});for(const m of th.messages||[]){if((m.labelIds||[]).includes('DRAFT'))continue;const sender=header_(m,'From'),incoming=!(m.labelIds||[]).includes('SENT')&&!sender.toLowerCase().includes(cfg_(ss).email);const auto=!!header_(m,'Auto-Submitted')&&header_(m,'Auto-Submitted')!=='no';put_(ss,'messages',{id:m.id,contact_id:c.id,threadId:m.threadId,from:sender,subject:header_(m,'Subject'),body:plain_(m.payload).slice(0,20000)||m.snippet,date:Number(m.internalDate),incoming,auto});if(incoming&&!auto){c.status='replied';c.replied_at=Number(m.internalDate);put_(ss,'contacts',c);}count++;}PropertiesService.getUserProperties().setProperty('syncCursor',String((i+1)%cs.length));if(time_()-start>40000)break;}return {count};}
function mailstudioTick(){const me=actor_(),r=registry_()[me];if(!r||!r.sheet)return;lock_(()=>{const ss=sheet_(me),cfg=cfg_(ss);if(!cfg.enabled||cfg.hold)return;try{reconcile_(ss);sync_(ss);const tasks=rows_(ss,'tasks').filter(t=>t.state==='running'),cs=rows_(ss,'contacts'),os=rows_(ss,'outgoing'),now=time_();for(const t of tasks){const candidates=cs.filter(c=>c.batch===t.batch&&c.control==='active'&&c.status!=='replied');let candidate=null,kind='first';for(const c of candidates){if(c.status==='queued'){candidate=c;break;}if(c.status==='sent'&&c.frozen){const stage=c.follow_stage||0,next=stage===0?'follow1':stage===1?'follow2':null;if(next&&c.frozen[next]&&(now-c.last_sent)>=c.frozen[next+'_days']*86400000){candidate=c;kind=next;break;}}}if(!candidate){if(!candidates.some(c=>c.status==='queued'||(c.status==='sent'&&c.frozen&&((!c.follow_stage&&c.frozen.follow1)||(c.follow_stage===1&&c.frozen.follow2))))){t.state='done';put_(ss,'tasks',t);}continue;}check_(cfg,os,kind,now);const body=kind==='first'?candidate.body:render_(candidate.frozen[kind],candidate);send_(ss,candidate,kind,body,uid_(),[]);break;}}catch(e){PropertiesService.getUserProperties().setProperty('lastTick',JSON.stringify({time:time_(),detail:String(e.message).slice(0,500)}));}});}
